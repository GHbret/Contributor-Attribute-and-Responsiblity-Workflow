    <sequenceFlow id="sequenceFlow7" sourceRef="gateway_action" targetRef="scripttask_removeRole" name="Remove role">
      <extensionElements>
        <design:stencilid><![CDATA[SequenceFlow]]></design:stencilid>
      </extensionElements>
